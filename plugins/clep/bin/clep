#!/usr/bin/env python3
"""clep — bundled plugin CLI (stdlib only, no deps).

Talks to the hosted Clep backend so Claude Code can scan features and
render clips without any local pipeline install.

Env (checked first; falls back to ~/.clep/config.json, written by `clep
configure`):
  CLEP_API_URL  base URL, default the hosted Clep backend (override for self-hosting)
  CLEP_API_KEY  platform API key (dashboard -> API Keys). Required when the
                backend sets CLEP_API_KEYS; sent as X-API-Key.

Usage:
  clep configure [--url URL] [--key KEY]   interactive if flags omitted
  clep scan <url>

  # feature: single instrumented click (original behavior, unchanged)
  clep clip --url URL --name NAME [--query Q --style S --fps N
            --quality {720p,1080p} --steps-file plan.json --wait [--out f.mp4]]

  # tour: scroll walkthrough, no data-clep needed
  clep clip --url URL --kind tour --duration 20 --sections "hero,pricing,contact"

  # launch: maps the whole page end-to-end, then shoots
  clep clip --url URL --kind launch --duration 25

  # natural language: parsed server-side, any other flag here still overrides
  clep clip --prompt "tour of https://x showing hero, pricing, 20s, calm"

  clep jobs
  clep job <id> [--wait [--timeout SEC] [--out file.mp4]]
  clep health
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

_CONFIG_PATH = Path.home() / ".clep" / "config.json"
_HOSTED_URL = "https://clep-platform-919279481036.us-central1.run.app"
_VERSION = "0.2.8"
_VERSION_CHECK_URL = (
    "https://raw.githubusercontent.com/techwarq/clep-plugin/main/"
    "plugins/clep/.claude-plugin/plugin.json"
)
_VERSION_CHECK_TTL = 24 * 3600


def _load_config() -> dict:
    try:
        return json.loads(_CONFIG_PATH.read_text())
    except Exception:
        return {}


def _save_config(cfg: dict) -> None:
    _CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    _CONFIG_PATH.write_text(json.dumps(cfg, indent=2))
    _CONFIG_PATH.chmod(0o600)


def _version_tuple(v: str) -> tuple[int, ...]:
    parts = []
    for p in v.strip().split("."):
        try:
            parts.append(int(p))
        except ValueError:
            break
    return tuple(parts)


def _check_update() -> None:
    """Best-effort, cached, never fatal: prints one line if a newer plugin
    version is published. Silent on any failure (offline, GitHub down,
    rate-limited) — this must never block or break a real command."""
    cfg = _load_config()
    cached = cfg.get("_update_check") or {}
    now = time.time()
    latest = cached.get("latest")
    if not isinstance(cached.get("checked_at"), (int, float)) or now - cached["checked_at"] > _VERSION_CHECK_TTL:
        try:
            req = urllib.request.Request(_VERSION_CHECK_URL)
            with urllib.request.urlopen(req, timeout=2) as resp:
                latest = json.loads(resp.read()).get("version")
        except Exception:
            latest = cached.get("latest")
        cfg["_update_check"] = {"checked_at": now, "latest": latest}
        try:
            _save_config(cfg)
        except Exception:
            pass
    if latest and _version_tuple(latest) > _version_tuple(_VERSION):
        print(
            f"[clep] update available: {_VERSION} -> {latest} — in Claude Code, run "
            f"`/plugin marketplace update clep-marketplace` then `/reload-plugins`.",
            file=sys.stderr,
        )


def _base() -> str:
    url = os.environ.get("CLEP_API_URL") or _load_config().get("api_url") or _HOSTED_URL
    return url.rstrip("/")


def _key() -> str:
    return (os.environ.get("CLEP_API_KEY") or _load_config().get("api_key") or "").strip()


def _req(method: str, path: str, body: dict | None = None) -> tuple[int, dict | bytes]:
    url = _base() + path
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(url, data=data, method=method)
    if data:
        r.add_header("Content-Type", "application/json")
    if _key():
        r.add_header("X-API-Key", _key())
    try:
        with urllib.request.urlopen(r, timeout=60) as resp:
            raw = resp.read()
            ctype = resp.headers.get("Content-Type", "")
            if "application/json" in ctype:
                return resp.status, json.loads(raw or b"{}")
            return resp.status, raw
    except urllib.error.HTTPError as e:
        try:
            payload = json.loads(e.read() or b"{}")
        except Exception:
            payload = {"error": f"HTTP {e.code}"}
        if e.code == 401:
            payload = {"error": "unauthorized: no valid API key. Run `clep configure` and paste the key "
                                 "from the dashboard -> API Keys."}
        print(f"[clep] error: {payload.get('error', payload)}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        # Connection-level failure (refused/DNS/timeout/no network) — never
        # reached a backend at all, so there was no HTTP response to read a
        # 401 off of. _base() defaults to the real hosted URL now, so this
        # is a genuine reachability problem (network down, or --url points
        # somewhere broken), not "forgot to configure."
        print(f"[clep] error: can't reach {url} ({e.reason}). Check your network, or "
              f"`clep configure --url` if you meant to point elsewhere.", file=sys.stderr)
        sys.exit(1)


def _box(title: str, lines: list[str], footer: str, inner: int = 60, max_inner: int = 96) -> None:
    import textwrap
    # NO_COLOR (https://no-color.org) and dumb terminals opt out of ANSI —
    # plain ASCII box still renders fine either way, just unstyled.
    color = not os.environ.get("NO_COLOR") and os.environ.get("TERM", "") != "dumb"
    bold = "\033[1m" if color else ""
    dim = "\033[2m" if color else ""
    reset = "\033[0m" if color else ""

    # URLs stay intact (breaking one mid-string makes it unusable) — everything
    # else wraps to `inner` so prose doesn't stretch the box.
    wrapped = [
        w for l in lines
        for w in ([l] if "://" in l else (textwrap.wrap(l, inner) or [""]))
    ]
    content_width = max(len(title), len(footer), *(len(l) for l in wrapped))
    width = min(max(content_width, inner), max_inner) + 2

    border = lambda s: f"{dim}{s}{reset}"
    print(border("┌" + "─" * width + "┐"))
    print(f"{border('│')}  {bold}{title.ljust(width - 2)}{reset}{border('│')}")
    print(border("│" + " " * width + "│"))
    for l in wrapped:
        print(f"{border('│')}  {l.ljust(width - 2)}{border('│')}")
    print(border("│" + " " * width + "│"))
    print(f"{border('│')}  {dim}{footer.ljust(width - 2)}{reset}{border('│')}")
    print(border("└" + "─" * width + "┘"))


def cmd_configure(a) -> None:
    url = a.url
    key = a.key
    interactive = sys.stdin.isatty() and not key
    if interactive:
        _box(
            "API key",
            [
                "Clep needs an API key to render clips on your account.",
                "",
                "Get one from your Clep dashboard's API Keys page",
                "(create a new one, or Copy an existing row).",
            ],
            "enter submit · esc to cancel (Ctrl+C)",
        )
        while not key:
            key = input("\nAPI key: ").strip()
    if not key:
        print("[clep] error: no API key given (pass --key or run without flags to be prompted)", file=sys.stderr)
        sys.exit(1)
    # --url is only for self-hosters, and only applies for *this* run — never
    # falls back to whatever was in the config file before, or a stale/wrong
    # URL saved once would keep re-saving itself forever. Always the hosted
    # default unless --url is explicitly given right now.
    url = (url or _HOSTED_URL).rstrip("/")
    _save_config({"api_url": url, "api_key": key})
    print(f"[clep] saved {_CONFIG_PATH}" + (f" (api_url={url})" if a.url else ""))


def cmd_health(_a) -> None:
    code, payload = _req("GET", "/api/health")
    print(json.dumps(payload, indent=2))


def cmd_scan(a) -> None:
    code, payload = _req("GET", "/api/features?url=" + urllib.parse.quote(a.url, safe=""))
    if isinstance(payload, dict) and payload.get("error"):
        print(f"[clep] error: {payload['error']}", file=sys.stderr)
        sys.exit(1)
    feats = payload.get("features", []) if isinstance(payload, dict) else []
    print(f"[clep] {len(feats)} feature(s) on {a.url}:")
    for f in feats:
        print(f"  - {f.get('name')} — input={f.get('has_input')} "
              f"button={f.get('has_button')} label={f.get('button_label')!r} "
              f"states={f.get('states')}")
    if not feats:
        print('[clep] tip: add data-clep="name" to the app, then re-run.')


def _load_steps(path: str | None):
    if not path:
        return None
    raw = json.loads(open(path).read())
    return raw.get("steps", raw) if isinstance(raw, dict) else raw


def _wait_job(job_id: str, timeout: float, out: str | None) -> dict:
    deadline = time.monotonic() + timeout
    job: dict = {}
    while time.monotonic() < deadline:
        _, job = _req("GET", f"/api/jobs/{job_id}")
        status = job.get("status") if isinstance(job, dict) else None
        print(f"[clep] {job_id}: {status}", file=sys.stderr)
        if status in ("done", "error"):
            break
        time.sleep(3)
    else:
        print(f"[clep] timed out after {timeout:.0f}s — job still {job.get('status')}", file=sys.stderr)
        sys.exit(2)
    if job.get("status") == "error":
        print(f"[clep] job failed: {job.get('error')}", file=sys.stderr)
        sys.exit(1)
    if out and job.get("out"):
        _download(job["out"], out)
        job["downloaded"] = out
    return job


def _download(out_path: str, dest: str) -> None:
    src = out_path if out_path.startswith("http") else _base() + out_path
    r = urllib.request.Request(src)
    if _key():
        r.add_header("X-API-Key", _key())
    with urllib.request.urlopen(r, timeout=120) as resp, open(dest, "wb") as f:
        f.write(resp.read())
    print(f"[clep] saved {dest}")


def cmd_clip(a) -> None:
    body: dict = {}
    if a.prompt:
        body["prompt"] = a.prompt
    if a.url:
        body["url"] = a.url
    if a.name:
        body["name"] = a.name
    if a.kind:
        body["kind"] = a.kind
    if a.query:
        body["query"] = a.query
    if a.sections:
        body["sections"] = [s.strip() for s in a.sections.split(",") if s.strip()]
    if a.duration:
        body["duration"] = a.duration
    if a.movement:
        body["movement"] = a.movement
    if a.style:
        body["style"] = a.style
    if a.fps:
        body["fps"] = a.fps
    if a.quality:
        body["quality"] = a.quality
    if a.size:
        body["size"] = a.size
    if a.bg:
        body["bg"] = a.bg
    if a.no_captions:
        body["captions"] = False
    steps = _load_steps(a.steps_file)
    if steps:
        body["steps"] = steps
    _, payload = _req("POST", "/api/clips", body)
    jid = payload.get("job_id", "") if isinstance(payload, dict) else ""
    label = a.name or a.kind or "clip"
    print(f"[clep] job {jid} queued ({label} @ {a.url or a.prompt or '?'})")
    if a.wait:
        job = _wait_job(jid, a.timeout, a.out)
        print(json.dumps(job, indent=2))
    else:
        print(f"[clep] poll: clep job {jid} --wait")


def cmd_jobs(_a) -> None:
    _, payload = _req("GET", "/api/jobs")
    jobs = payload.get("jobs", []) if isinstance(payload, dict) else []
    if not jobs:
        print("[clep] no jobs yet — run: clep clip --url URL --name NAME --wait")
        return
    for j in jobs:
        print(f"  {j.get('id')}  {j.get('status'):9s}  {j.get('name')}  {j.get('out') or j.get('error') or ''}")


def cmd_job(a) -> None:
    if a.wait:
        job = _wait_job(a.id, a.timeout, a.out)
        print(json.dumps(job, indent=2))
    else:
        _, payload = _req("GET", f"/api/jobs/{a.id}")
        print(json.dumps(payload, indent=2))
        if a.out and isinstance(payload, dict) and payload.get("out"):
            _download(payload["out"], a.out)


def build() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="clep", description="Clep plugin CLI — features to MP4 via hosted backend.")
    sub = p.add_subparsers(dest="cmd", required=True)

    cfg = sub.add_parser("configure", help="Save CLEP_API_URL/CLEP_API_KEY to ~/.clep/config.json.")
    cfg.add_argument("--url", default=None)
    cfg.add_argument("--key", default=None)
    cfg.set_defaults(fn=cmd_configure)

    s = sub.add_parser("scan", help="List data-clep features on a live URL.")
    s.add_argument("url")
    s.set_defaults(fn=cmd_scan)

    c = sub.add_parser("clip", help="Render a clip job.")
    c.add_argument("--url", default=None, help="App URL to clip. Required unless --prompt embeds "
                   "one, or --kind mockup (no live page needed).")
    c.add_argument("--name", default=None, help="data-clep name — feature kind only "
                   "(omit for tour/launch/mockup, or when a plain --prompt covers it).")
    c.add_argument("--kind", default=None, choices=["auto", "tour", "feature", "mockup", "launch"],
                   help="tour: scroll walkthrough, no data-clep needed. launch: maps the whole "
                        "page end-to-end first, then shoots. feature: single instrumented click "
                        "(default when --name is given, unchanged original behavior). mockup: "
                        "synthetic UI render, no browser at all.")
    c.add_argument("--prompt", default=None, help="Natural-language clip request, e.g. \"tour of "
                   "https://x showing hero, pricing, 20s, calm\" — parsed server-side into url/"
                   "kind/sections/duration/style/movement. Any other flag here still overrides "
                   "what the prompt implied.")
    c.add_argument("--sections", default=None, help="Comma-separated tour stops, e.g. "
                   "\"hero, pricing, contact\" [tour/launch].")
    c.add_argument("--duration", default=None, type=float, help="Output seconds, 2-60. Feature "
                   "clips are ~2-5s by default; tour/launch need this set to cover more ground.")
    c.add_argument("--movement", default=None, choices=["calm", "standard", "dynamic"],
                   help="Camera feel (default: calm for tour/launch, standard for feature).")
    c.add_argument("--query", default=None)
    c.add_argument("--style", default=None, choices=["minimal", "saas", "cinematic", "apple"])
    c.add_argument("--fps", default=None, type=int, choices=[30, 60])
    c.add_argument("--quality", default=None, choices=["720p", "1080p"])
    c.add_argument("--size", default=None, help="Exact canvas WxH, e.g. 1120x640 (landing-page "
                   "card) — overrides --quality.")
    c.add_argument("--bg", default=None, help="Backdrop override: preset (saas/minimal/cinematic/"
                   "apple/blush), \"#a,#b[,#c]\", or \"solid:#hex\".")
    c.add_argument("--no-captions", action="store_true", help="Disable on-screen section captions [tour/launch].")
    c.add_argument("--steps-file", default=None)
    c.add_argument("--wait", action="store_true")
    c.add_argument("--timeout", type=float, default=300)
    c.add_argument("--out", default=None, help="Download MP4 here when done (implies --wait done path).")
    c.set_defaults(fn=cmd_clip)

    j = sub.add_parser("jobs", help="List clip jobs (newest first).")
    j.set_defaults(fn=cmd_jobs)

    g = sub.add_parser("job", help="Show / wait / download one job.")
    g.add_argument("id")
    g.add_argument("--wait", action="store_true")
    g.add_argument("--timeout", type=float, default=300)
    g.add_argument("--out", default=None)
    g.set_defaults(fn=cmd_job)

    h = sub.add_parser("health", help="Backend liveness check (no auth).")
    h.set_defaults(fn=cmd_health)
    return p


def main() -> None:
    try:
        _check_update()
    except Exception:
        pass
    a = build().parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
